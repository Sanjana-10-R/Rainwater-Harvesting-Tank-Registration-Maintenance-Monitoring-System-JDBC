CREATE TABLE TANK_TBL4 (
    TANK_ID VARCHAR2(10) PRIMARY KEY,
    PROPERTY_BLOCK VARCHAR2(30) NOT NULL,
    LOCATION VARCHAR2(150) NOT NULL,
    CAPACITY_LITERS NUMBER(10),
    INSTALLATION_DATE DATE,
    SERVICE_FREQ VARCHAR2(30),
    LAST_SERVICE_DATE DATE,
    STATUS VARCHAR2(20)
);


