CREATE TABLE MAINT_VISIT_TBL4 (
    VISIT_ID NUMBER(10) PRIMARY KEY,
    TANK_ID VARCHAR2(10) NOT NULL,
    SCHEDULED_DATE DATE,
    TIME_SLOT VARCHAR2(20),
    STAFF_ID VARCHAR2(20),
    VISIT_TYPE VARCHAR2(30),
    VISIT_STATUS VARCHAR2(20),
    CREATED_DATE DATE,
    REMARKS VARCHAR2(300),
    CONSTRAINT FK_TANK_VISIT FOREIGN KEY (TANK_ID) REFERENCES TANK_TBL4(TANK_ID)
);


CREATE SEQUENCE SEQ_VISIT_ID START WITH 1 INCREMENT BY 1;

CREATE TABLE MAINT_REPORT_TBL4 (
    REPORT_ID NUMBER(10) PRIMARY KEY,
    VISIT_ID NUMBER(10) NOT NULL,
    CLEAN VARCHAR2(10),
    WATER_LEVEL_PERCENT NUMBER(5),
    FILTER_PIPE_CONDITION VARCHAR2(300),
    SLUDGE_OBSERVED_LEVEL VARCHAR2(300),
    TECHNICIAN_NOTES VARCHAR2(300),
    REPORT_STATUS VARCHAR2(20),
    CONSTRAINT FK_VISIT_REPORT FOREIGN KEY (VISIT_ID) REFERENCES MAINT_VISIT_TBL4(VISIT_ID)
);

